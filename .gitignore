# ==== 파이썬이 실행하면서 자동으로 만드는 임시 파일 ====
# 파이썬이 실행 속도를 높이려고 만드는 캐시 폴더와 파일
__pycache__/
*.pyc
# 파이썬 가상환경 폴더 (나중에 만들 수도 있어서 미리 뺀다)
.venv/
venv/

# ==== 개인 설정 / 비밀이 들어갈 수 있는 파일 ====
# Claude Code의 내 컴퓨터 전용 설정 (권한 기록 등)
.claude/settings.local.json
# API 키 같은 비밀 값을 넣는 파일 (지금은 없지만 실수 방지)
.env

# ==== 운영체제·편집기가 만드는 파일 ====
# 윈도우가 폴더마다 만드는 썸네일·설정 파일
Thumbs.db
desktop.ini
# 맥이 만드는 폴더 정보 파일
.DS_Store
# VS Code의 내 컴퓨터 전용 설정
.vscode/
